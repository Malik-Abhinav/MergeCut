# MergeCut environment variables (see PROJECT_PLAN §27).
# Copy to .env and fill in real values; never commit .env.

# --- GMI Cloud / MiniMax ---
# Get these from your GMI Cloud account dashboard.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
MINIMAX_M3_MODEL=MiniMaxAI/MiniMax-M3
MINIMAX_M27_MODEL=MiniMaxAI/MiniMax-M2.7

# --- Local storage (relative paths) ---
UPLOAD_DIR=./data/uploads
DERIVED_DIR=./data/derived
DATABASE_PATH=./data/mergecut.db

# --- MVP input limits ---
MAX_VIDEO_SECONDS=180
MAX_UPLOAD_MB=250

# --- Media preprocessing (Phase 2) ---
# Leave FFMPEG_PATH / FFPROBE_PATH empty to use whatever is on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# PySceneDetect ContentDetector threshold; lower = more sensitive.
SCENE_THRESHOLD=27.0
# faster-whisper model. tiny/base/small/medium/large-v3; 'tiny' and 'base' are
# fastest and run on CPU; 'small' is a good quality/speed tradeoff.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# VAD minimum silence (ms) — faster-whisper's default is 2000ms,
# which collapses sub-second inter-shot silence; we tighten it
# so Phase 3 fixtures produce separate per-shot segments.
WHISPER_MIN_SILENCE_MS=200
# Whisper transcription chunk length (seconds). faster-whisper
# concatenates VAD chunks up to this length before running the
# decoder; smaller values force more (and shorter) decoded
# segments. Phase 3 fixtures use 5s so 5-shot videos produce
# 5 transcribed segments.
WHISPER_CHUNK_LENGTH=5